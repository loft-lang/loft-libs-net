use server;
use web;

fn server_arm_plain(port: integer) {
  srv = server::listen(port);
  req = srv.next();
  if req != null { req.respond(200, "hello-plain"); }
  srv.close();
}

fn server_arm_html(port: integer, body: text) {
  srv = server::listen(port);
  req = srv.next();
  if req != null { req.respond_html(body); }
  srv.close();
}

fn server_arm_css(port: integer, body: text) {
  srv = server::listen(port);
  req = srv.next();
  if req != null { req.respond_css(body); }
  srv.close();
}

fn client_arm_get(port: integer, expect_status: integer, expect_body: text) {
  web::sleep_ms(50);
  url = "http://127.0.0.1:{port}/";
  r = web::http_get(url);
  assert(r.status == expect_status, "status mismatch");
  assert(r.body == expect_body, "body mismatch");
}

fn test_http_plain_round_trip() {
  port = 19501;
  parallel {
    server_arm_plain(port);
    client_arm_get(port, 200, "hello-plain");
  }
}

fn test_respond_html() {
  port = 19502;
  parallel {
    server_arm_html(port, "<h1>hi</h1>");
    client_arm_get(port, 200, "<h1>hi</h1>");
  }
}

fn test_respond_css() {
  port = 19503;
  parallel {
    server_arm_css(port, "body {{ color: red; }}");
    client_arm_get(port, 200, "body {{ color: red; }}");
  }
}

fn server_arm_js(port: integer, body: text) {
  srv = server::listen(port);
  req = srv.next();
  if req != null { req.respond_js(body); }
  srv.close();
}

fn server_arm_404(port: integer) {
  srv = server::listen(port);
  req = srv.next();
  if req != null { req.respond_404(); }
  srv.close();
}

fn server_arm_typed(port: integer, status: integer, body: text, ct: text) {
  srv = server::listen(port);
  req = srv.next();
  if req != null { req.respond_typed(status, body, ct); }
  srv.close();
}

fn test_respond_js() {
  port = 19504;
  parallel {
    server_arm_js(port, "console.log('hi');");
    client_arm_get(port, 200, "console.log('hi');");
  }
}

fn test_respond_404() {
  port = 19505;
  parallel {
    server_arm_404(port);
    client_arm_get(port, 404, "Not Found");
  }
}

fn test_respond_typed_custom() {
  // application/json with 201 Created — exercises respond_typed's
  // custom-status + custom-content-type surface.
  port = 19506;
  body = "{{\"created\":true}}";
  parallel {
    server_arm_typed(port, 201, body, "application/json");
    client_arm_get(port, 201, body);
  }
}
