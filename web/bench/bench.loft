//
// bench — the performance pass for the binary-frame helpers: `pack_u8` and `byte_at`,
// the two routines that cross into the native crate once per BYTE, timed on a fixed
// workload with a hash of what they produced.
//
//     loft --interpret bench/bench.loft [--n N]         the interpreter
//     loft --native-release bench/bench.loft [--n N]    compiled
//     bench/.build/stats_rs [--n N]                     the pure-Rust twin (bench/bench.rs)
//
// One tab-separated line per routine: name, iterations, total µs, ns per op, bytes per op
// (`px`), ns per byte, and an FNV-1a-32 hash of the output.  Every byte is one call into
// the native crate, so `ns_px` is the cost of ONE crossing plus the callee's few
// instructions — the calibration constant other native ratios are read against.  The
// Rust twin runs the callee's body with no crossing at all; the hash says both lanes
// computed the same bytes.
//
// Each repetition feeds different VALUES (a salt in the packed bytes, a rotated read
// offset) through the same amount of work, and folds its result into `sink`.
use web::*;

/// One measured routine.
struct Row {
  name: text = "",
  iters: integer = 0,
  us: integer = 0,
  px: integer = 0,
  hash: integer = 0,
  sink: integer = 0,
}

const FNV_OFFSET = 2166136261;
const FNV_PRIME = 16777619;

/// FNV-1a-32 over the low 32 bits of each integer, high byte first.
fn fnv(h0: integer, v: const vector<integer>) -> integer {
  fv_h = h0;
  for x in v {
    fv_w = x & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 24) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 16) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 8) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ (fv_w & 255)) * FNV_PRIME) & 0xFFFFFFFF;
  }
  fv_h
}

/// FNV-1a-32 over the raw bytes of a text, read with the STANDARD LIBRARY's `byte_at`, so
/// the hash of a packed frame does not lean on the routine under test.
fn fnv_text(h0: integer, t: text) -> integer {
  ft_h = h0;
  for ft_i in 0..size(t) {
    ft_h = ((ft_h ^ t.byte_at(ft_i)) * FNV_PRIME) & 0xFFFFFFFF;
  }
  ft_h
}

fn print_row(r: const Row) {
  pr_ns = ((r.us * 1000) / r.iters) ?? 0;
  pr_px = if r.px > 0 { (((r.us * 1000) as float) / ((r.iters * r.px) as float)) ?? 0.0 }
          else { 0.0 };
  println("{r.name}\t{r.iters}\t{r.us}\t{pr_ns}\t{r.px}\t{pr_px:.3}\t{r.hash:x}");
}

// ── Send side: one crossing per byte ────────────────────────────────

const PK_FRAMES = 1024;
const PK_BYTES = 1024;

/// One op: PK_FRAMES frames of PK_BYTES bytes, each built with `pack_reset`, one `pack_u8`
/// per byte (the value unmasked — the callee masks it) and `pack_take`.  Answers the
/// frames' total size; `frames`, when given, collects every frame for the hash.
fn pack_frames(salt: integer, frames: &vector<text>, keep: boolean) -> integer {
  pf_total = 0;
  for pf_f in 0..PK_FRAMES {
    web::pack_reset();
    for pf_k in 0..PK_BYTES {
      web::pack_u8(pf_k * 131 + pf_f * 7 + salt * 13);
    }
    pf_fr = web::pack_take();
    pf_total += size(pf_fr);
    if keep { frames += [pf_fr]; }
  }
  pf_total
}

fn bench_pack_u8(n: integer) -> Row {
  bp_none: vector<text> = [];
  bp_t0 = ticks();
  bp_sink = 0;
  for bp_r in 0..n {
    bp_sink += pack_frames(bp_r, bp_none, false);
  }
  bp_us = ticks() - bp_t0;
  bp_frames: vector<text> = [];
  pack_frames(0, bp_frames, true);
  bp_h = FNV_OFFSET;
  for bp_fr in bp_frames { bp_h = fnv_text(bp_h, bp_fr); }
  Row { name: "pack_u8", iters: n, us: bp_us, px: PK_FRAMES * PK_BYTES, hash: bp_h,
        sink: bp_sink }
}

// ── Receive side: one crossing per byte ─────────────────────────────

const BA_SIZE = 65536;
const BA_PASSES = 16;

/// The 64 KiB frame every byte value occurs in, NUL included — built the way a sender
/// builds one, with the pack builder.
fn byte_frame() -> text {
  web::pack_reset();
  for bf_k in 0..BA_SIZE { web::pack_u8(bf_k * 131 + (bf_k >> 8) * 7); }
  web::pack_take()
}

/// One op: BA_PASSES full reads of the frame, each from a rotated start, every byte read
/// with `byte_at` and folded into a polynomial hash so each one counts.
fn read_frame(fr: text, salt: integer) -> integer {
  rf_acc = 0;
  for rf_p in 0..BA_PASSES {
    rf_off = salt * 17 + rf_p * 4099;
    for rf_i in 0..BA_SIZE {
      rf_acc = (rf_acc * 31 + web::byte_at((rf_i + rf_off) & 65535, fr)) & 0xFFFFFFFF;
    }
  }
  rf_acc
}

fn bench_byte_at(n: integer) -> Row {
  bb_fr = byte_frame();
  bb_t0 = ticks();
  bb_sink = 0;
  for bb_r in 0..n {
    bb_sink += read_frame(bb_fr, bb_r);
  }
  bb_us = ticks() - bb_t0;
  bb_one: vector<integer> = [read_frame(bb_fr, 0), size(bb_fr), fnv_text(FNV_OFFSET, bb_fr)];
  Row { name: "byte_at", iters: n, us: bb_us, px: BA_PASSES * BA_SIZE,
        hash: fnv(FNV_OFFSET, bb_one), sink: bb_sink }
}

fn main() {
  mn_n = 20;
  mn_args = arguments();
  mn_i = 0;
  while mn_i < len(mn_args) {
    if mn_args[mn_i]? == "--n" && mn_i + 1 < len(mn_args) {
      mn_n = (mn_args[mn_i + 1]? as integer?)?;
      mn_i += 1;
    }
    mn_i += 1;
  }
  if mn_n < 1 { mn_n = 1; }
  println("routine\titers\tus\tns_op\tpx\tns_px\thash");
  print_row(bench_pack_u8(mn_n));
  print_row(bench_byte_at(mn_n));
}
